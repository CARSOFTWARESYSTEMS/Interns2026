{
  // Type-checks the Vercel Function (api/) and server/ code against Node.
  // Relative imports carry .js extensions: Vercel runs these files as Node ESM.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api", "server"],
  "exclude": ["server/**/*.test.ts"]
}
