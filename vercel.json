{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/api/auth(?:/(.*))?$",
      "dest": "/api/auth?__route=$1"
    },
    {
      "src": "^/(?:index\\.html|(?:[^/]+/)*[^/.]*)$",
      "has": [{ "type": "host", "value": { "eq": "login.itelematics.com" } }],
      "dest": "/index.itelematics.html"
    },
    {
      "src": "^/(?:index\\.html|(?:[^/]+/)*[^/.]*)$",
      "has": [{ "type": "host", "value": { "eq": "login.gamyaa.in" } }],
      "dest": "/index.gamyaa.html"
    },
    {
      "src": "^/(?:index\\.html|(?:[^/]+/)*[^/.]*)$",
      "has": [{ "type": "host", "value": { "eq": "login.uflight.in" } }],
      "dest": "/index.uflight.html"
    },
    {
      "src": "^/(?:index\\.html|(?:[^/]+/)*[^/.]*)$",
      "has": [{ "type": "host", "value": { "eq": "login.autonomous.ev.engineer" } }],
      "dest": "/index.ev-engineer.html"
    },
    {
      "src": "^/(?:index\\.html|(?:[^/]+/)*[^/.]*)$",
      "dest": "/index.html"
    }
  ]
}
